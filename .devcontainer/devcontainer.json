{
  "name": "model-serving",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "hostRequirements": { "cpus": 2 },
  "remoteEnv": { "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin" },
  "postCreateCommand": {
    "python": "pip install --user uv && ~/.local/bin/uv sync",
    "claude": "curl -fsSL https://claude.ai/install.sh | bash"
  },
  "forwardPorts": [8080, 8000],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "anthropic.claude-code"]
    }
  }
}
